<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinBit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinBit"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinBit">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid AllowDrop="True"
          DragOver="OnDragOver"
          Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="48"
              Padding="16,0,160,0"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png"
                       Width="20"
                       Height="20"
                       VerticalAlignment="Center"
                       AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="WinBit"
                           VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="AddTorrentButton"
                        Click="OnAddTorrentClicked"
                        Style="{ThemeResource AccentButtonStyle}"
                        Padding="12,4"
                        CornerRadius="16"
                        AutomationProperties.Name="Add torrent">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add torrent" />
                    </StackPanel>
                </Button>
                <Button x:Name="AddMagnetButton"
                        Click="OnAddMagnetClicked"
                        Padding="12,4"
                        CornerRadius="16"
                        AutomationProperties.Name="Add magnet link">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71B;" FontSize="14" />
                        <TextBlock Text="Magnet" />
                    </StackPanel>
                </Button>
                <Button x:Name="AddFromUrlButton"
                        Click="OnAddFromUrlClicked"
                        Padding="12,4"
                        CornerRadius="16"
                        AutomationProperties.Name="Add torrent from URL">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE753;" FontSize="14" />
                        <TextBlock Text="URL" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="AltSpeedToggle"
                              Padding="10,4"
                              CornerRadius="16"
                              Click="OnAltSpeedToggleClicked"
                              IsChecked="{x:Bind Status.AltSpeedEnabled, Mode=OneWay}"
                              AutomationProperties.Name="Toggle alternative speed limits"
                              ToolTipService.ToolTip="Alternative speed limits">
                    <FontIcon Glyph="&#xE945;" FontSize="14" />
                </ToggleButton>
                <AppBarSeparator />
                <Button x:Name="ThemeButton"
                        Click="OnThemeClicked"
                        Padding="8,4"
                        CornerRadius="16"
                        AutomationProperties.Name="Toggle theme">
                    <FontIcon Glyph="&#xE706;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1" />

        <tb:TaskbarIcon x:Name="TrayIcon"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        ToolTipText="WinBit"
                        NoLeftClickDelay="True"
                        LeftClickCommand="{x:Bind ToggleVisibilityCommand}"
                        DoubleClickCommand="{x:Bind ShowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout Placement="Top">
                    <MenuFlyoutItem Text="Show WinBit"
                                    Click="OnTrayShowClicked">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Hide to tray"
                                    Click="OnTrayHideClicked">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE711;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Add magnet link…"
                                    Click="OnAddMagnetClicked">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE71B;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <ToggleMenuFlyoutItem Text="Alternative speed limits"
                                          IsChecked="{x:Bind Status.AltSpeedEnabled, Mode=OneWay}"
                                          Click="OnTrayAltSpeedClicked">
                        <ToggleMenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE945;" />
                        </ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit WinBit"
                                    Click="OnTrayExitClicked">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="16"
                            VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Status.GlobalDownloadText, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Status.GlobalUploadText, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Status.ConnectionsText, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Status.DhtNodesText, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ToggleButton Grid.Column="1"
                              x:Name="AltSpeedFooterToggle"
                              Click="OnAltSpeedToggleClicked"
                              IsChecked="{x:Bind Status.AltSpeedEnabled, Mode=OneWay}"
                              Padding="10,2"
                              CornerRadius="14"
                              AutomationProperties.Name="Toggle alternative speed limits"
                              ToolTipService.ToolTip="Alternative speed limits">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE945;" FontSize="12" />
                        <TextBlock Text="{x:Bind Status.AltSpeedText, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Border>
    </Grid>
</Window>

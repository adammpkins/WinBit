<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinBit.Views.Search.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinBit.ViewModels.Search"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="16,12,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="QueryBox"
                     PlaceholderText="Search across configured providers…"
                     Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnQueryKeyDown"
                     AutomationProperties.Name="Search query" />

            <Button Grid.Column="1"
                    Content="Search"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="OnSearchClicked"
                    AutomationProperties.Name="Run search" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DropDownButton Grid.Column="0"
                            x:Name="PluginFilterButton"
                            Content="Providers"
                            AutomationProperties.Name="Filter by provider">
                <DropDownButton.Flyout>
                    <Flyout Placement="Bottom">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.PluginToggles, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:SearchPluginToggle">
                                    <CheckBox Content="{x:Bind DisplayName}"
                                              IsChecked="{x:Bind Enabled, Mode=TwoWay}"
                                              MinWidth="160" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <TextBlock Grid.Column="1"
                       Text="{x:Bind ResultCountText(ViewModel.ResultCount), Mode=OneWay}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" />

            <ProgressRing Grid.Column="2"
                          Width="18"
                          Height="18"
                          IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
        </Grid>

        <Border Grid.Row="2"
                CornerRadius="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="24" />

                <ListView x:Name="ResultsList"
                          ItemsSource="{x:Bind ViewModel.Hits, Mode=OneWay}"
                          SelectionMode="Single"
                          Background="Transparent"
                          Visibility="{x:Bind HasHits(ViewModel.ResultCount), Mode=OneWay}">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" Padding="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Name"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Size"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Seeders"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Leechers"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="Provider"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="8,2" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchHitRowViewModel">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Name}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind Name}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind SizeText}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind SeedersText}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind LeechersText}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind PluginName}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="5"
                                        Content="Add"
                                        IsEnabled="{x:Bind CanAdd}"
                                        Click="OnAddClicked"
                                        Tag="{x:Bind}"
                                        AutomationProperties.Name="Add this result as a torrent" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinBit.Views.Dialogs.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="About WinBit"
    CloseButtonText="Close"
    DefaultButton="Close"
    CornerRadius="8"
    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
        <StackPanel MinWidth="460" MaxWidth="520" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="48" Height="48" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="WinBit"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind VersionText}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock TextWrapping="Wrap"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Text="A modern, Windows-native rebuild of qBittorrent with a WinUI 3 front end and MonoTorrent under the hood." />

            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    CornerRadius="6"
                    Padding="12,10">
                <StackPanel Spacing="6">
                    <TextBlock Text="Built with"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="• MonoTorrent — BitTorrent engine"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Text="• CommunityToolkit.WinUI — Fluent controls and SettingsCards"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Text="• CommunityToolkit.Mvvm — source-gen MVVM"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Text="• H.NotifyIcon.WinUI — system tray integration"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Text="• WinUI.TableView — transfer list"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Text="• Microsoft.Graphics.Win2D — speed graph and piece bars"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <HyperlinkButton Content="Project page" NavigateUri="https://github.com/" />
                <HyperlinkButton Content="Report an issue" NavigateUri="https://github.com/" />
            </StackPanel>

            <TextBlock TextWrapping="Wrap"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind CopyrightText}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

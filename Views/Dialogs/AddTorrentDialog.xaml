<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinBit.Views.Dialogs.AddTorrentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dialogs="using:WinBit.Views.Dialogs"
    mc:Ignorable="d"
    Title="Add torrent"
    PrimaryButtonText="Add"
    SecondaryButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8"
    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
    </ContentDialog.Resources>

    <Grid Height="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Torrent file" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TorrentPathBox"
                         Grid.Column="0"
                         PlaceholderText="No file picked yet"
                         IsReadOnly="True"
                         AutomationProperties.Name="Selected torrent file" />
                <Button Grid.Column="1"
                        Content="Pick .torrent…"
                        Click="OnPickTorrentClicked"
                        AutomationProperties.Name="Pick a .torrent file" />
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   x:Name="TorrentNameText"
                   Margin="0,12,0,4"
                   Style="{ThemeResource SubtitleTextBlockStyle}"
                   Text="" />

        <Border Grid.Row="2"
                Margin="0,4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <TreeView x:Name="FilesTree"
                      SelectionMode="Single"
                      CanDragItems="False"
                      CanReorderItems="False"
                      Background="Transparent">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="dialogs:PreviewNode">
                        <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="True">
                            <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind IconGlyph}"
                                              FontSize="12"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Name}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind SizeText}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <StackPanel Grid.Row="3" Spacing="4" Margin="0,12,0,0">
            <TextBlock Text="Tags" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <DropDownButton x:Name="TagsButton"
                            Content="(no tags)"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.Name="Tags">
                <DropDownButton.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel MinWidth="240" Spacing="8">
                            <TextBlock x:Name="TagsEmptyText"
                                       Text="No tags defined yet — add some in Categories &amp; Tags."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                            <ListView x:Name="TagsList"
                                      SelectionMode="Multiple"
                                      MaxHeight="220"
                                      SelectionChanged="OnTagsSelectionChanged" />
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <TextBlock Text="Category" Margin="0,8,0,0" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <ComboBox x:Name="CategoryCombo"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="(none)"
                      SelectionChanged="OnCategorySelectionChanged"
                      AutomationProperties.Name="Category" />
            <TextBlock Text="Save to" Margin="0,8,0,0" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SavePathCombo"
                          Grid.Column="0"
                          HorizontalAlignment="Stretch"
                          IsEditable="True"
                          PlaceholderText="Default downloads folder"
                          AutomationProperties.Name="Save path" />
                <Button Grid.Column="1"
                        Content="Browse…"
                        Click="OnBrowseSaveClicked"
                        AutomationProperties.Name="Browse for save folder" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,12,0,0" Spacing="8">
            <Expander Header="Share limits"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock Text="Leave a field at 0 (or 'Use global default') to inherit from the global configuration."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <NumberBox x:Name="RatioLimitBox"
                               Header="Ratio cap (0 = use global)"
                               Minimum="0"
                               SmallChange="0.1"
                               SpinButtonPlacementMode="Inline"
                               Value="0" />
                    <NumberBox x:Name="SeedingMinutesBox"
                               Header="Seeding time (minutes, 0 = use global)"
                               Minimum="0"
                               SmallChange="30"
                               SpinButtonPlacementMode="Inline"
                               Value="0" />
                    <NumberBox x:Name="InactiveMinutesBox"
                               Header="Inactive seeding time (minutes, 0 = use global)"
                               Minimum="0"
                               SmallChange="30"
                               SpinButtonPlacementMode="Inline"
                               Value="0" />
                    <ComboBox x:Name="ActionCombo"
                              Header="Action on limit"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Use global default" Tag="Default" IsSelected="True" />
                        <ComboBoxItem Content="Stop" Tag="Stop" />
                        <ComboBoxItem Content="Remove" Tag="Remove" />
                        <ComboBoxItem Content="Remove with content" Tag="RemoveWithContent" />
                        <ComboBoxItem Content="Enable super seeding" Tag="EnableSuperSeeding" />
                    </ComboBox>
                </StackPanel>
            </Expander>
            <CheckBox x:Name="StartImmediatelyCheck"
                      Content="Start immediately"
                      IsChecked="True" />
        </StackPanel>

        <InfoBar Grid.Row="5"
                 x:Name="ErrorBar"
                 Margin="0,12,0,0"
                 Severity="Error"
                 IsClosable="False"
                 IsOpen="False" />
    </Grid>
</ContentDialog>

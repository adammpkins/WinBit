<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinBit.Views.Dialogs.EditTrackerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Edit tracker"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8"
    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="12">
        <TextBox x:Name="UrlBox"
                 Header="Tracker URL"
                 PlaceholderText="https://tracker.example.com/announce"
                 TextChanged="OnUrlChanged"
                 AutomationProperties.Name="Tracker URL" />
        <NumberBox x:Name="TierBox"
                   Header="Tier"
                   Value="0"
                   Minimum="0"
                   Maximum="255"
                   SpinButtonPlacementMode="Inline"
                   AutomationProperties.Name="Tier" />
    </StackPanel>
</ContentDialog>

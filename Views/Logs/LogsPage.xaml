<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinBit.Views.Logs.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinBit.ViewModels.Logs"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="16,12,16,16">
        <Pivot x:Name="LogsPivot">
            <PivotItem Header="General">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Severity:"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <CheckBox Content="Normal" IsChecked="{x:Bind ViewModel.ShowNormal, Mode=TwoWay}" />
                            <CheckBox Content="Info" IsChecked="{x:Bind ViewModel.ShowInfo, Mode=TwoWay}" />
                            <CheckBox Content="Warning" IsChecked="{x:Bind ViewModel.ShowWarning, Mode=TwoWay}" />
                            <CheckBox Content="Critical" IsChecked="{x:Bind ViewModel.ShowCritical, Mode=TwoWay}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Clear view"
                                Click="OnClearExecutionClicked"
                                ToolTipService.ToolTip="Removes rows from this view. The underlying log buffer is untouched." />
                    </Grid>

                    <Border Grid.Row="1"
                            CornerRadius="4"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <ListView x:Name="LogList"
                                  ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  ShowsScrollingPlaceholders="False"
                                  Background="Transparent">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="8,2" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:LogRowViewModel">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind TimestampText}"
                                                   FontFamily="Consolas"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind SeverityText}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind Message}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </PivotItem>

            <PivotItem Header="Peers">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Peers rejected by the engine (IP filter, bad protocol, etc.)"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />

                        <Button Grid.Column="1"
                                Content="Clear view"
                                Click="OnClearPeersClicked"
                                ToolTipService.ToolTip="Removes rows from this view. The underlying log buffer is untouched." />
                    </Grid>

                    <Border Grid.Row="1"
                            CornerRadius="4"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <ListView x:Name="PeerList"
                                  ItemsSource="{x:Bind PeerViewModel.Rows, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  Background="Transparent">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="8,2" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PeerLogRowViewModel">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind TimestampText}"
                                                   FontFamily="Consolas"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind PeerEndpoint}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   IsTextSelectionEnabled="True"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind Reason}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinBit.Views.Settings.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="32,24,32,48">
        <StackPanel Spacing="12" MaxWidth="880">
            <TextBlock Text="Advanced" Style="{ThemeResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="Performance knobs most users should leave alone."
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <controls:SettingsCard Header="Async I/O threads"
                                   Description="Worker threads for disk reads and writes. Higher isn't always better.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEDA2;" />
                </controls:SettingsCard.HeaderIcon>
                <NumberBox x:Name="AsyncIoThreadsBox"
                           Value="4"
                           Minimum="1"
                           Maximum="64"
                           SpinButtonPlacementMode="Compact"
                           MinWidth="140" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>

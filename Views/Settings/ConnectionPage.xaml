<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinBit.Views.Settings.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" MaxWidth="880" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Spacing="12" Margin="0,24,0,48">
            <TextBlock Text="Connection" Style="{ThemeResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="Listen port, port forwarding, and proxy configuration."
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <controls:SettingsCard Header="Listen port"
                                   Description="Incoming BitTorrent connections arrive on this TCP/UDP port.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE839;" />
                </controls:SettingsCard.HeaderIcon>
                <NumberBox x:Name="ListenPortBox"
                           Value="6881"
                           Minimum="1024"
                           Maximum="65535"
                           SpinButtonPlacementMode="Compact"
                           MinWidth="140"
                           ValueChanged="OnListenPortChanged" />
            </controls:SettingsCard>

            <controls:SettingsCard Header="UPnP / NAT-PMP"
                                   Description="Ask the router to forward the listen port automatically.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEC05;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="UpnpToggle" IsOn="True" Toggled="OnUpnpToggled" />
            </controls:SettingsCard>

            <controls:SettingsExpander Header="Proxy"
                                       Description="Route .torrent downloads and other HTTP calls through a proxy. Engine peer sockets do not route through this proxy.">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </controls:SettingsExpander.HeaderIcon>
                <ComboBox x:Name="ProxyTypeCombo"
                          SelectedIndex="0"
                          MinWidth="160"
                          SelectionChanged="OnProxyTypeChanged">
                    <ComboBoxItem Content="None" Tag="None" />
                    <ComboBoxItem Content="HTTP" Tag="Http" />
                    <ComboBoxItem Content="SOCKS5" Tag="Socks5" />
                </ComboBox>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Host"
                                           Description="Proxy server hostname or IP.">
                        <TextBox x:Name="ProxyHostBox"
                                 MinWidth="240"
                                 PlaceholderText="proxy.example.com"
                                 TextChanged="OnProxyHostChanged" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Port">
                        <NumberBox x:Name="ProxyPortBox"
                                   Value="1080"
                                   Minimum="1"
                                   Maximum="65535"
                                   SpinButtonPlacementMode="Compact"
                                   MinWidth="140"
                                   ValueChanged="OnProxyPortChanged" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Username"
                                           Description="Leave blank if the proxy doesn't require authentication.">
                        <TextBox x:Name="ProxyUsernameBox"
                                 MinWidth="240"
                                 TextChanged="OnProxyUsernameChanged" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Password">
                        <PasswordBox x:Name="ProxyPasswordBox"
                                     MinWidth="240"
                                     PasswordChanged="OnProxyPasswordChanged" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

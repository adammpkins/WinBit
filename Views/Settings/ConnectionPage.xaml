<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinBit.Views.Settings.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="32,24,32,48">
        <StackPanel Spacing="12" MaxWidth="880">
            <TextBlock Text="Connection" Style="{ThemeResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="Listen port, port forwarding, and proxy configuration."
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <controls:SettingsCard Header="Listen port"
                                   Description="Incoming BitTorrent connections arrive on this TCP/UDP port.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE839;" />
                </controls:SettingsCard.HeaderIcon>
                <NumberBox x:Name="ListenPortBox"
                           Value="6881"
                           Minimum="1024"
                           Maximum="65535"
                           SpinButtonPlacementMode="Compact"
                           MinWidth="140" />
            </controls:SettingsCard>

            <controls:SettingsCard Header="UPnP / NAT-PMP"
                                   Description="Ask the router to forward the listen port automatically.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEC05;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="UpnpToggle" IsOn="True" />
            </controls:SettingsCard>

            <controls:SettingsExpander Header="Proxy"
                                       Description="Route peer and tracker traffic through a proxy.">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </controls:SettingsExpander.HeaderIcon>
                <ComboBox x:Name="ProxyTypeCombo" SelectedIndex="0" MinWidth="160">
                    <ComboBoxItem Content="None" />
                    <ComboBoxItem Content="HTTP" />
                    <ComboBoxItem Content="SOCKS5" />
                </ComboBox>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Host"
                                           Description="Proxy server hostname or IP.">
                        <TextBox MinWidth="240" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Port">
                        <NumberBox Value="1080" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" MinWidth="140" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>

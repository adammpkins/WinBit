<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinBit.Views.Settings.WatchedFoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:WinBit.Views.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="FolderItemTemplate" x:DataType="local:WatchedFolderItemViewModel">
            <controls:SettingsCard Header="{x:Bind Path}"
                                   Description="{x:Bind Description}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </controls:SettingsCard.HeaderIcon>
                <Button Tag="{x:Bind RawPath}"
                        Click="OnRemoveClicked"
                        Style="{ThemeResource DefaultButtonStyle}"
                        AutomationProperties.Name="Remove watched folder">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
            </controls:SettingsCard>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" MaxWidth="880" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Spacing="12" Margin="0,24,0,48">
                <TextBlock Text="Watched Folders" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                <TextBlock Text="Folders monitored for .torrent files. Each file found is added automatically."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AddFolderButton"
                            Grid.Column="1"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="OnAddFolderClicked"
                            AutomationProperties.Name="Add watched folder">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Add folder" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock x:Name="EmptyStateText"
                           Text="No watched folders. Click Add folder to get started."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,24,0,0"
                           Visibility="Collapsed" />

                <ListView x:Name="FolderList"
                          ItemTemplate="{StaticResource FolderItemTemplate}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          Visibility="Collapsed">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinBit.Views.Transfers.TransfersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinBit.ViewModels.Transfers"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    MaxWidth="440">
            <Border Width="140" Height="140"
                    CornerRadius="70"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <FontIcon Glyph="&#xE896;"
                          FontSize="56"
                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="No torrents yet"
                       HorizontalAlignment="Center"
                       Style="{ThemeResource TitleLargeTextBlockStyle}" />

            <TextBlock Text="Add a .torrent file or paste a magnet link to start downloading."
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Margin="0,8,0,0">
                <Button Style="{ThemeResource AccentButtonStyle}"
                        Padding="16,8"
                        CornerRadius="18"
                        Click="OnAddTorrentClicked"
                        AutomationProperties.Name="Add torrent file">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add torrent" />
                    </StackPanel>
                </Button>
                <Button Padding="16,8"
                        CornerRadius="18"
                        Click="OnAddMagnetClicked"
                        AutomationProperties.Name="Add magnet">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71B;" FontSize="14" />
                        <TextBlock Text="Paste magnet" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Text="Tip: drop a .torrent file anywhere on this window."
                       HorizontalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </Grid>
</Page>

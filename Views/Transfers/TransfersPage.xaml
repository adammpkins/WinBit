<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinBit.Views.Transfers.TransfersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:WinBit.Views.Transfers"
    xmlns:controls="using:WinBit.Controls"
    xmlns:tv="using:WinUI.TableView"
    xmlns:vm="using:WinBit.ViewModels.Transfers"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="8,8,0,8"
                CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <StackPanel Padding="8" Spacing="6">
                <TextBlock Text="Filters"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           Margin="4,0,0,4" />
                <TreeView x:Name="FilterTree"
                          ItemInvoked="OnFilterInvoked"
                          SelectionMode="Single"
                          CanDragItems="False"
                          CanReorderItems="False"
                          Background="Transparent" />
                <Border BorderThickness="0,1,0,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Margin="0,6,0,0"
                        Padding="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <HyperlinkButton Content="Manage categories…"
                                         Click="OnManageCategoriesClicked" />
                        <HyperlinkButton Content="Manage tags…"
                                         Click="OnManageTagsClicked" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Visibility="{x:Bind local:TransfersPage.VisibleIfTrue(ViewModel.HasTorrents), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
            </Grid.RowDefinitions>

            <tv:TableView x:Name="TransfersGrid"
                      Grid.Row="0"
                      ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedTorrentRow, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      CornerRadius="4"
                      AlternateRowBackground="{ThemeResource LayerFillColorAltBrush}"
                      Background="Transparent"
                      Padding="16,12,16,16"
                      RightTapped="OnTransfersGridRightTapped">
                <tv:TableView.ContextFlyout>
                    <MenuFlyout Opening="OnContextMenuOpening">
                        <MenuFlyoutItem x:Name="RenameMenuItem" Text="Rename" Click="OnRenameClicked">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F2" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Resume" Click="OnResumeClicked">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="R" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Pause" Click="OnPauseClicked">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE769;" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="P" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Force recheck" Click="OnForceRecheckClicked">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Force reannounce" Click="OnForceReannounceClicked">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EE;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Speed limits…" Click="OnSpeedLimitsClicked">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEC4A;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Share limits…" Click="OnShareLimitsClicked">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74C;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Open folder" Click="OnOpenFolderClicked">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Copy magnet" Click="OnCopyMagnetClicked">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="C" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Remove" Click="OnRemoveClicked">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Delete" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </tv:TableView.ContextFlyout>
            <tv:TableView.Columns>
                <tv:TableViewTextColumn Tag="name" Header="Name" Binding="{Binding Name}" Width="240" MinWidth="140" />
                <tv:TableViewTextColumn Tag="size" Header="Size" Binding="{Binding SizeText}" Width="96" />

                <tv:TableViewTemplateColumn Tag="progress" Header="Progress" Width="140" MinWidth="100">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:TransferRowViewModel">
                            <Grid Padding="8,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0"
                                             Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                             Maximum="100"
                                             Height="6"
                                             CornerRadius="3"
                                             Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                             VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ProgressText, Mode=OneWay}"
                                           Margin="8,0,0,0"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>

                <tv:TableViewTemplateColumn Tag="state" Header="State" Width="120" MinWidth="90">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:TransferRowViewModel">
                            <controls:StatePill State="{x:Bind State, Mode=OneWay}"
                                                Margin="8,0" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>

                <tv:TableViewTextColumn Tag="seeds" Header="Seeds" Binding="{Binding Seeds}" Width="64" />
                <tv:TableViewTextColumn Tag="peers" Header="Peers" Binding="{Binding Peers}" Width="64" />
                <tv:TableViewTextColumn Tag="down" Header="Down" Binding="{Binding DownloadText}" Width="96" />
                <tv:TableViewTextColumn Tag="up" Header="Up" Binding="{Binding UploadText}" Width="96" />
                <tv:TableViewTextColumn Tag="ratio" Header="Ratio" Binding="{Binding RatioText}" Width="72" />
                <tv:TableViewTextColumn Tag="eta" Header="ETA" Binding="{Binding EtaText}" Width="96" />
                <tv:TableViewTextColumn Tag="added" Header="Added" Binding="{Binding AddedText}" Width="140" />
                <tv:TableViewTextColumn Tag="completed" Header="Completed" Binding="{Binding CompletedText}" Width="140" />
                <tv:TableViewTextColumn Tag="category" Header="Category" Binding="{Binding Category}" Width="120" />
                <tv:TableViewTextColumn Tag="tags" Header="Tags" Binding="{Binding TagsText}" Width="160" />
            </tv:TableView.Columns>
        </tv:TableView>

            <Border Grid.Row="1"
                    Height="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Margin="16,0" />

            <Pivot x:Name="PropertiesPivot"
                   Grid.Row="2"
                   Padding="16,8,16,16"
                   Background="Transparent">
                <PivotItem Header="General">
                    <ScrollViewer>
                        <StackPanel Spacing="6" MaxWidth="720" HorizontalAlignment="Left">
                            <TextBlock Text="Torrent details"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Info hash, save path, comment, creation date, and fast-resume status populate in a later M4 deliverable."
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Trackers">
                    <tv:TableView
                        ItemsSource="{x:Bind ViewModel.Properties.Trackers, Mode=OneWay}"
                        SelectionMode="Single"
                        IsReadOnly="True"
                        AutoGenerateColumns="False">
                        <tv:TableView.Columns>
                            <tv:TableViewTextColumn Header="URL"
                                                    Binding="{Binding Url}"
                                                    MinWidth="200" />
                            <tv:TableViewTextColumn Header="Status"
                                                    Binding="{Binding StatusDisplay}"
                                                    MinWidth="100" />
                            <tv:TableViewTextColumn Header="Seeds"
                                                    Binding="{Binding SeedsDisplay}"
                                                    MinWidth="65" />
                            <tv:TableViewTextColumn Header="Leeches"
                                                    Binding="{Binding LeechesDisplay}"
                                                    MinWidth="65" />
                            <tv:TableViewTextColumn Header="Downloaded"
                                                    Binding="{Binding CompletedDisplay}"
                                                    MinWidth="85" />
                            <tv:TableViewTextColumn Header="Next Announce"
                                                    Binding="{Binding NextAnnounceDisplay}"
                                                    MinWidth="115" />
                            <tv:TableViewTextColumn Header="Message"
                                                    Binding="{Binding LastError}"
                                                    MinWidth="120" />
                        </tv:TableView.Columns>
                    </tv:TableView>
                </PivotItem>
                <PivotItem Header="Peers">
                    <tv:TableView
                        ItemsSource="{x:Bind ViewModel.Properties.Peers, Mode=OneWay}"
                        SelectionMode="Single"
                        IsReadOnly="True"
                        AutoGenerateColumns="False">
                        <tv:TableView.Columns>
                            <tv:TableViewTextColumn Header="IP / Port"
                                                    Binding="{Binding Address}"
                                                    MinWidth="140" />
                            <tv:TableViewTextColumn Header="Client"
                                                    Binding="{Binding Client}"
                                                    MinWidth="160" />
                            <tv:TableViewTextColumn Header="Flags"
                                                    Binding="{Binding Flags}"
                                                    MinWidth="60" />
                            <tv:TableViewTemplateColumn Header="Progress"
                                                        MinWidth="100">
                                <tv:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:PeerRowViewModel">
                                        <ProgressBar Value="{x:Bind Progress, Mode=OneWay}"
                                                     Minimum="0" Maximum="1"
                                                     Width="80"
                                                     VerticalAlignment="Center" />
                                    </DataTemplate>
                                </tv:TableViewTemplateColumn.CellTemplate>
                            </tv:TableViewTemplateColumn>
                            <tv:TableViewTextColumn Header="Down"
                                                    Binding="{Binding DownloadText}"
                                                    MinWidth="90" />
                            <tv:TableViewTextColumn Header="Up"
                                                    Binding="{Binding UploadText}"
                                                    MinWidth="90" />
                        </tv:TableView.Columns>
                    </tv:TableView>
                </PivotItem>
                <PivotItem Header="Content">
                    <StackPanel Spacing="6" Padding="0,8" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Content"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="File tree with per-file priority (Do not download / Low / Normal / High). Hosts the PiecesBar once bitfield data is wired."
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </PivotItem>
                <PivotItem Header="Speed">
                    <Grid Padding="0,8" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Speed"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <controls:SpeedGraph Grid.Row="1"
                                             x:Name="SpeedChart"
                                             MinHeight="180" />

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Spacing="16"
                                    HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Rectangle Width="14" Height="3"
                                           RadiusX="1.5" RadiusY="1.5"
                                           Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="Download"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Rectangle Width="14" Height="3"
                                           RadiusX="1.5" RadiusY="1.5"
                                           Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="Upload"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Rolling 10-minute window populates once the selection + per-tab poll lands."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </PivotItem>
            </Pivot>
        </Grid>

        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    MaxWidth="440"
                    Visibility="{x:Bind local:TransfersPage.VisibleIfTrue(ViewModel.IsEmpty), Mode=OneWay}">
            <Border Width="140" Height="140"
                    CornerRadius="70"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <FontIcon Glyph="&#xE896;"
                          FontSize="56"
                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="No torrents yet"
                       HorizontalAlignment="Center"
                       Style="{ThemeResource TitleLargeTextBlockStyle}" />

            <TextBlock Text="Add a .torrent file or paste a magnet link to start downloading."
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Margin="0,8,0,0">
                <Button Style="{ThemeResource AccentButtonStyle}"
                        Padding="16,8"
                        CornerRadius="18"
                        Click="OnAddTorrentClicked"
                        AutomationProperties.Name="Add torrent file">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add torrent" />
                    </StackPanel>
                </Button>
                <Button Padding="16,8"
                        CornerRadius="18"
                        Click="OnAddMagnetClicked"
                        AutomationProperties.Name="Add magnet">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71B;" FontSize="14" />
                        <TextBlock Text="Paste magnet" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Text="Tip: drop a .torrent file anywhere on this window."
                       HorizontalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </Grid>
</Page>

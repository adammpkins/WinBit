<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinBit.Views.Rss.AutoDownloaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:WinBit.Views.Rss"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <Button Click="OnBackClicked"
                    AutomationProperties.Name="Back to RSS">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Back" />
                </StackPanel>
            </Button>
            <TextBlock Text="Auto-downloader"
                       Style="{ThemeResource TitleLargeTextBlockStyle}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <InfoBar x:Name="StatusBar"
                 Grid.Row="1"
                 IsOpen="False"
                 IsClosable="True" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                    <Button Click="OnNewRuleClicked"
                            AutomationProperties.Name="New rule">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="New rule" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnDeleteRuleClicked"
                            IsEnabled="{x:Bind HasSelection, Mode=OneWay}"
                            AutomationProperties.Name="Delete rule">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock Text="Delete" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="1">
                    <ListView x:Name="RuleList"
                              SelectionMode="Single"
                              SelectionChanged="OnRuleSelectionChanged"
                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="8"
                              Padding="4">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:RuleListItem">
                                <Grid Padding="6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0"
                                              FontSize="12"
                                              Glyph="{x:Bind StateGlyph, Mode=OneWay}"
                                              Foreground="{x:Bind StateBrush, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Name, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="EmptyList"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <FontIcon Glyph="&#xE8C8;"
                                  FontSize="36"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No rules yet"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Click New rule to start."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <ScrollViewer Grid.Column="1"
                          IsEnabled="{x:Bind HasSelection, Mode=OneWay}">
                <StackPanel Spacing="12" MaxWidth="720">
                    <controls:SettingsCard Header="Rule name"
                                           Description="Unique identifier shown in the list and logs.">
                        <TextBox x:Name="NameBox" MinWidth="280" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Enabled"
                                           Description="When off, the rule is skipped during evaluation.">
                        <ToggleSwitch x:Name="EnabledToggle" IsOn="True" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Must contain"
                                           Description="Space-separated AND tokens. Use | for OR between expressions.">
                        <TextBox x:Name="MustContainBox" MinWidth="360" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Must not contain"
                                           Description="Any expression matching this rejects the article.">
                        <TextBox x:Name="MustNotContainBox" MinWidth="360" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Use regular expressions"
                                           Description="Treat Must/Must-not fields as a raw regex instead of wildcards.">
                        <ToggleSwitch x:Name="UseRegexToggle" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Episode filter"
                                           Description="qBittorrent syntax: 1x5;8-12;15-">
                        <TextBox x:Name="EpisodeFilterBox" MinWidth="240" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Smart episode filter"
                                           Description="Suppresses re-download of the same season/episode.">
                        <ToggleSwitch x:Name="SmartFilterToggle" />
                    </controls:SettingsCard>

                    <controls:SettingsExpander Header="Affected feeds"
                                               Description="When blank, the rule applies to every feed.">
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard ContentAlignment="Vertical">
                                <ListView x:Name="FeedsList"
                                          SelectionMode="Multiple"
                                          MinHeight="140"
                                          MaxHeight="240"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:FeedOption">
                                            <TextBlock Text="{x:Bind Url}" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OnSaveClicked"
                                AutomationProperties.Name="Save rule" />
                        <Button Content="Revert" Click="OnRevertClicked"
                                AutomationProperties.Name="Revert changes" />
                    </StackPanel>

                    <controls:SettingsCard Header="Live tester"
                                           Description="Type an article title to see whether the saved rule would match it.">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE721;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="TestTitleBox"
                                     MinWidth="320"
                                     PlaceholderText="Show.S01E05.1080p" />
                            <Button Content="Test" Click="OnTestClicked"
                                    AutomationProperties.Name="Run live test" />
                            <TextBlock x:Name="TestResultText"
                                       VerticalAlignment="Center"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                    </controls:SettingsCard>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinBit</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="WinBit.Core\**;WinBit.Tests\**;libtorrentsharp\**;qbittorrent\**;tools\**" />
    <Content Remove="WinBit.Core\**;WinBit.Tests\**;libtorrentsharp\**;qbittorrent\**;tools\**" />
    <None Remove="WinBit.Core\**;WinBit.Tests\**;libtorrentsharp\**;qbittorrent\**;tools\**" />
    <Page Remove="WinBit.Core\**;WinBit.Tests\**;libtorrentsharp\**;qbittorrent\**;tools\**" />
    <ApplicationDefinition Remove="WinBit.Core\**;WinBit.Tests\**;libtorrentsharp\**;qbittorrent\**;tools\**" />
    <EmbeddedResource Remove="WinBit.Core\**;WinBit.Tests\**;libtorrentsharp\**;qbittorrent\**;tools\**" />
    <PRIResource Remove="WinBit.Core\**;WinBit.Tests\**;libtorrentsharp\**;qbittorrent\**;tools\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-100.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-100.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\AppIcon.png" />
    <Content Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="CommunityToolkit.WinUI.Collections" />
    <PackageReference Include="WinUI.TableView" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="WinBit.Core\WinBit.Core.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Trimming breaks MonoTorrent: DHT bootstrap and tracker protocol serialization
         rely on reflection paths the static trimmer can't see, so the Release build silently
         loses peer discovery. Keep trimming off until we audit MonoTorrent for trim safety. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- R2R is also suspected of interacting badly with MonoTorrent's reflection paths;
         the Release MSIX installed fine but DHT stayed NotReady while the Debug-deployed
         build worked. Keep off until we confirm it isn't the culprit. -->
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>

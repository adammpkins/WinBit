<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Project-specific color tokens. Default brushes should always resolve from the Fluent
        palette (AccentFillColorDefaultBrush, CardBackgroundFillColorDefaultBrush,
        TextFillColorPrimaryBrush, etc.). Any tokens defined below get light/dark overrides
        via the ThemeDictionaries at the bottom.
    -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light" />
        <ResourceDictionary x:Key="Dark" />
        <ResourceDictionary x:Key="HighContrast" />
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

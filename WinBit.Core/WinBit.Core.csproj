<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>WinBit.Core</RootNamespace>
    <AssemblyName>WinBit.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinBit.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libtorrentsharp\LibtorrentSharp\LibtorrentSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-process Kestrel for the M10 Web UI. Pulls in Microsoft.AspNetCore.* via the
         shared framework rather than discrete packages to stay aligned with the target .NET
         runtime on end-user machines. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence\SqlMigrations\*.sql" />
  </ItemGroup>

  <!--
    Build the Vue SPA before compilation so embedded resources are up-to-date.
    Set SkipVueBuild=true (e.g. in CI that builds the frontend separately) to skip.
    VS's MSBuild child processes do not inherit the user PATH, so Node.js must be
    located by its install directory and injected into PATH for the entire subprocess
    tree (npm.cmd → vite → node all need to resolve each other).
  -->
  <PropertyGroup>
    <!-- Standard Node.js installer location; override NodejsDir if you use nvm or a custom prefix. -->
    <NodejsDir Condition="'$(NodejsDir)' == '' and Exists('$(ProgramFiles)\nodejs\node.exe')">$(ProgramFiles)\nodejs</NodejsDir>
    <NodejsDir Condition="'$(NodejsDir)' == ''">.</NodejsDir>
  </PropertyGroup>

  <Target Name="BuildVueSpa" BeforeTargets="BeforeBuild"
          Condition="'$(SkipVueBuild)' != 'true' and Exists('$(SolutionDir)webui\package.json')">
    <Message Text="Building WinBit Vue SPA..." Importance="high" />
    <!-- MSBuild Exec writes commands to a temp .cmd file so %PATH% expands at CMD runtime.
         Prepending NodejsDir to PATH ensures node.exe is found by npm and its subprocesses
         (e.g. vite) even when VS's MSBuild environment lacks the user PATH entries. -->
    <Exec Command="set &quot;PATH=$(NodejsDir);%PATH%&quot; &amp;&amp; &quot;$(NodejsDir)\npm.cmd&quot; install --no-audit --no-fund"
          WorkingDirectory="$(SolutionDir)webui"
          Condition="!Exists('$(SolutionDir)webui\node_modules')" />
    <Exec Command="set &quot;PATH=$(NodejsDir);%PATH%&quot; &amp;&amp; &quot;$(NodejsDir)\npm.cmd&quot; run build"
          WorkingDirectory="$(SolutionDir)webui" />
  </Target>

  <!--
    Embed the Vue SPA assets into WinBit.Core.dll. Done in a target (not a static
    ItemGroup) so the glob is re-evaluated AFTER BuildVueSpa has populated
    WebUi\WinBitApp\. A static <EmbeddedResource Include="..."/> evaluates at
    project-load time and would match zero files on a clean CI checkout.
  -->
  <Target Name="EmbedVueSpa" AfterTargets="BuildVueSpa" BeforeTargets="CoreCompile">
    <ItemGroup>
      <EmbeddedResource Include="WebUi\WinBitApp\**\*.*" />
    </ItemGroup>
  </Target>
</Project>
